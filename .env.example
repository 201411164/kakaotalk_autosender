# DB (V1 로그인 시 필요). 실제 값은 커밋하지 마세요.
SERVICE_TYPE=live

DATABASE_HOST=your-db-host.example.com
DATABASE_PORT=16751
DATABASE_USER=your_db_user
DATABASE_PASSWORD=your_db_password

ERP_DATABASE_NAME=erpdb
TAX_DATABASE_NAME=taxdb
ALARM_DATABASE_NAME=alarmdb
CUSTOMER_DATABASE_NAME=customerdb

# 앱 모드 (개발 시; exe 빌드는 entry_v1 / entry_v2 가 설정)
# KAKAO_SENDER_MODE=v2
# KAKAO_SENDER_DRY_RUN=1
# KAKAO_SENDER_GUEST_USER_ID=1
# KAKAO_SENDER_GUEST_NICKNAME=게스트

# AI 자동 응답 후보 생성 (V3 prototype)
# 실제 키는 커밋하지 마세요.
OPENAI_API_KEY=your_openai_api_key
OPENAI_MODEL=gpt-5.4-mini

# V3 원격 제어 Hub / Agent (동일 토큰을 Hub·Controller·Agent에 설정)
# KAKAO_REMOTE_HUB_URL=http://192.168.0.10:8765
# KAKAO_REMOTE_TOKEN=your_shared_secret
# KAKAO_REMOTE_PC_ID=office-pc-1
# KAKAO_REMOTE_ENABLE=1

# V3 자동 업데이트 (GitHub Releases onedir zip)
# KAKAO_SENDER_DISABLE_AUTO_UPDATE=0
# KAKAO_SENDER_AUTO_UPDATE_INTERVAL_SEC=3600
# GITHUB_TOKEN=ghp_xxxx
